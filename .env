# Compose-interpolation variables (non-secret).
# Runtime config + secrets are supplied by fly.toml [env] and `fly secrets`.

# Pin to a stable Jitsi release (https://github.com/jitsi/docker-jitsi-meet/releases)
JITSI_IMAGE_VERSION=stable-11031

# Port mappings (Fly routes via internal_port; these satisfy compose parsing)
HTTP_PORT=80
HTTPS_PORT=443

# Jitsi writes generated config here. Fly ignores compose volumes, so this is
# ephemeral and regenerated from env on every boot — that's fine because all
# inter-component auth passwords are pinned via `fly secrets`.
CONFIG=/config

RESTART_POLICY=unless-stopped
